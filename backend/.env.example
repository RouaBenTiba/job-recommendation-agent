# Copier ce fichier en backend/.env puis renseigner les vraies valeurs.
# backend/.env est ignoré par Git : ne JAMAIS le versionner.

APP_ENV=development            # development | test | production
SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:5173"]

# # --- Base de données ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/jobreco

# --- LLM ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Sources d'offres ---

ADZUNA_APP_ID=
ADZUNA_APP_KEY=

JOOBLE_API_KEY=
TAVILY_API_KEY=

# --- Observabilité (optionnel) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
